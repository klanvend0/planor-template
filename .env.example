# Codeling environment
#
# Copy to `.env` and fill in. Nothing here is secret in the sense of "must not
# leak": every EXPO_PUBLIC_ value is compiled into the bundle and readable by
# anyone with the app. Secrets live in Supabase, pushed with
# `npm run supabase:secrets:set` — see the last section.
#
# ---------------------------------------------------------------------------
# The two modes
# ---------------------------------------------------------------------------
#
# No .env at all: the app runs entirely on the device. Sign-in becomes "start
# learning", progress is kept in AsyncStorage under the rules the server would
# have applied, the paywall sells a local entitlement and says plainly that
# nothing is charged, and explanations are marked against the key points the
# question bank already ships. Every screen works; nothing leaves the phone.
# This is what a fresh clone does, and it is what `npm start` gives a new
# contributor.
#
# With EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_KEY set: the app is the
# real thing — accounts, server-authoritative XP, the AI grader, RevenueCat.
# Supabase alone decides this. A project with a database but no RevenueCat key
# behaves like the shipped app during a store outage, not like the local mode.

# ---------------------------------------------------------------------------
# Supabase — the switch between the two modes above
# ---------------------------------------------------------------------------
# Project Settings -> API. The key is the anon/publishable one, never the
# service role key.
# Missing: the app runs on the device (see above).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# RevenueCat — subscriptions
# ---------------------------------------------------------------------------
# Project -> API keys -> App-specific public keys. Required for a build that
# actually sells anything.
# Missing (with Supabase set): the paywall reports the store as unavailable and
# every learner stays on the free plan. Nothing crashes, nothing is given away.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# PostHog — product analytics
# ---------------------------------------------------------------------------
# Missing: no events are sent and no client is created. The app is unaffected.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---------------------------------------------------------------------------
# Legal, support and store links
# ---------------------------------------------------------------------------
# App Review requires the Terms and Privacy links on the paywall to resolve to
# real pages that describe this app's subscription. The defaults below are
# placeholders and will fail review as they are.
# Missing: the built-in placeholder is used, which is a broken link.
EXPO_PUBLIC_TERMS_URL=https://codeling.app/terms
EXPO_PUBLIC_PRIVACY_URL=https://codeling.app/privacy
EXPO_PUBLIC_SUPPORT_URL=mailto:support@codeling.app

# Numeric App Store id, used by the "Rate Codeling" row in settings.
# Missing: the row still works but opens the App Store search instead.
EXPO_PUBLIC_APP_STORE_ID=

# ---------------------------------------------------------------------------
# EAS
# ---------------------------------------------------------------------------
# `eas init` writes the project id into app.json. Set this only to override it
# from CI; leaving it empty keeps whatever app.json already carries.
EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Server-side secrets — NOT here
# ---------------------------------------------------------------------------
# These belong to the edge functions and never ship in the bundle:
#
#   npm run supabase:secrets:set AI_API_KEY=... AI_MODEL=... AI_BASE_URL=...
#   npm run supabase:secrets:set REVENUECAT_WEBHOOK_SECRET=...
#   npm run supabase:secrets:set REVENUECAT_API_KEY=...
#   npm run supabase:secrets:set APPLE_CLIENT_ID=... APPLE_CLIENT_SECRET=...
#
# Without AI_API_KEY the grader returns 503 and the explain question shows an
# error; without REVENUECAT_WEBHOOK_SECRET the webhook rejects every delivery.
# See docs/BACKEND_SETUP.md. Google and Apple OAuth credentials are configured
# in the Supabase dashboard, not here — see docs/OAUTH_SETUP.md.
